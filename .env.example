# Copy this file to .env.local and fill in the values from your Supabase
# project: Project Settings > API Keys (publishable key) and Data API (URL).
# The publishable key is safe to ship in the app; never put the secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
