{
  "expo": {
    "name": "handyman-mobile",
    "slug": "handyman-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F7F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "We use your location to find your area and send a professional to the right address."
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "scheme": "handymanapp",
    "extra": {
      "eas": {
        "projectId": "b0be4149-3a9e-439e-8858-eb66da83949d"
      }
    },
    "owner": "sonish_khanal"
  }
}
